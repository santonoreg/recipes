# Αντέγραψε σε .env και συμπλήρωσε
ANTHROPIC_API_KEY=

# Claude
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
OUTPUT_LANGUAGE=Ελληνικά

# Whisper (τοπικό, μέσω Python). auto = GPU αν γίνεται, αλλιώς CPU
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto

# Για ιδιωτικά posts / ομάδες: firefox | chrome | edge  (ή διαδρομή σε cookies.txt)
COOKIES_BROWSER=
COOKIES_FILE=

# Καρέ
FRAME_INTERVAL=3
MAX_FRAMES=30

# Φάκελος με τα βίντεο/φωτογραφίες των συνταγών
OUTPUT_DIR=output

# ---- Νέα στην έκδοση PHP ----
SITE_NAME=Συνταγές

# Εξωτερικά εργαλεία. Κενό = αυτόματος εντοπισμός.
# PYTHON_BIN: Python με faster-whisper (π.χ. C:\...\old\.venv\Scripts\python.exe).
#   Αν έχει και yt-dlp / imageio-ffmpeg, χρησιμοποιούνται κι αυτά από εκεί.
PYTHON_BIN=
# YTDLP_BIN / FFMPEG_BIN: αυτόνομα yt-dlp.exe / ffmpeg.exe, αν δεν θες να έρχονται από το Python
YTDLP_BIN=
FFMPEG_BIN=
# PHP_BIN: php.exe της γραμμής εντολών (μόνο αν ο web server δεν το βρίσκει μόνος του)
PHP_BIN=
